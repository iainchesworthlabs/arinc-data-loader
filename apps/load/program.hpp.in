#pragma once

// What the program is called and which version it is, as `adl_load --version` and the `started` event
// say it. Generated by CMake from apps/load/program.hpp.in: the version is the project's.

#include <string_view>

namespace adl::load
{

// The program's name, without ".exe" on every system.
inline constexpr std::string_view program_name = "adl_load";

inline constexpr std::string_view program_version = "@PROJECT_VERSION@";

// The number of the events format (docs/load-command.md). A key can be added without changing it; removing
// a key, renaming one or changing what one means changes it.
inline constexpr unsigned events_format = 1;

} // namespace adl::load
