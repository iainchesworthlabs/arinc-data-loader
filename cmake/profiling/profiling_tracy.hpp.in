// Generated by cmake/Tracy.cmake when ADL_ENABLE_TRACY is on - not part of the source tree.
//
// The repository keeps the preprocessor out of its own C++
// (tools/checks/check_platform_isolation.ps1 forbids #if and #define, templates included), so this
// header is written by CMake: one flavour calls Tracy, the other does nothing, and both offer the
// same names to the instrumented files.
//
// Tracy 0.13.1 (vcpkg's "profiling" manifest feature, selected by -DADL_ENABLE_TRACY=ON).

#pragma once

#include <cstddef>
#include <cstdint>
#include <cstring>
#include <source_location>

#include <tracy/Tracy.hpp>

namespace adl::profiling {

// A scope, named for what it does and located at the line that opened it.
class Zone {
public:
    explicit Zone(const char* name,
                  const std::source_location& where = std::source_location::current()) noexcept
        : zone_(static_cast<std::uint32_t>(where.line()), where.file_name(),
                std::strlen(where.file_name()), where.function_name(),
                std::strlen(where.function_name()), name, std::strlen(name), 0) {}

    Zone(const Zone&) = delete;
    Zone& operator=(const Zone&) = delete;
    Zone(Zone&&) = delete;
    Zone& operator=(Zone&&) = delete;

    ~Zone() noexcept = default;

private:
    tracy::ScopedZone zone_;
};

inline void frame_mark() noexcept {
    FrameMark;
}

inline void plot(const char* name, double value) noexcept {
    TracyPlot(name, value);
}

inline void thread_name(const char* name) noexcept {
    tracy::SetThreadName(name);
}

inline void app_info(const char* text) noexcept {
    TracyAppInfo(text, std::strlen(text));
}

}  // namespace adl::profiling
