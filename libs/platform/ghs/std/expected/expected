// std::expected / std::unexpected shim for GHS builds whose standard library
// predates C++23. It exists so that the platform interfaces
// (libs/platform/interfaces/adl/platform/) stay untouched: they say
// std::expected, and a build with a toolchain that has no <expected> gets
// this header instead, shadowing the missing one through the include path
// (see cmake/GhsStdShims.cmake and docs/platform-ghs.md, "C++ standard and
// shims"). It is never included on a platform whose library has the real one.
//
// Scope: exactly what this code base uses - construction from a value or from
// an unexpected, operator bool, operator*/->, value(), value_or(), error(),
// has_value(), and the expected<void, E> form. There is deliberately no
// monadic API and no throwing value(): this project compiles without
// exceptions, and anything the project does not use fails to compile against
// the shim, which is the point of a shim.
//
// Adding names to namespace std is undefined behaviour by the letter of the
// standard; it is the accepted way to backfill one missing header for one
// toolchain, and this header is only ever in GHS builds. The constructors are
// not constexpr (nothing in the code base builds an expected in a constant
// expression; fail() returns std::unexpected, whose constructors are), which
// keeps the storage handling plain C++11 placement new.

#pragma once

#include <cstddef>
#include <memory>
#include <new>
#include <type_traits>
#include <utility>

namespace std {

struct unexpect_t {
    explicit unexpect_t() = default;
};
inline constexpr unexpect_t unexpect{};

template <class E>
class unexpected {
public:
    constexpr explicit unexpected(const E& error) noexcept(
        std::is_nothrow_copy_constructible<E>::value)
        : error_(error) {}
    constexpr explicit unexpected(E&& error) noexcept(
        std::is_nothrow_move_constructible<E>::value)
        : error_(std::move(error)) {}

    constexpr const E& error() const& noexcept { return error_; }
    constexpr E& error() & noexcept { return error_; }
    constexpr const E&& error() const&& noexcept { return std::move(error_); }
    constexpr E&& error() && noexcept { return std::move(error_); }

private:
    E error_;
};

template <class E>
unexpected(E) -> unexpected<E>;

template <class T, class E>
class expected {
public:
    using value_type = T;
    using error_type = E;
    using unexpected_type = unexpected<E>;

    expected() noexcept(std::is_nothrow_default_constructible<T>::value)
        : has_value_(true) {
        ::new (static_cast<void*>(std::addressof(value_))) T();
    }

    expected(const expected& other)
        : has_value_(other.has_value_) {
        if (has_value_) {
            ::new (static_cast<void*>(std::addressof(value_))) T(other.value_);
        } else {
            ::new (static_cast<void*>(std::addressof(error_))) E(other.error_);
        }
    }

    expected(expected&& other)
        : has_value_(other.has_value_) {
        if (has_value_) {
            ::new (static_cast<void*>(std::addressof(value_))) T(std::move(other.value_));
        } else {
            ::new (static_cast<void*>(std::addressof(error_))) E(std::move(other.error_));
        }
    }

    expected(const T& value) : has_value_(true) {
        ::new (static_cast<void*>(std::addressof(value_))) T(value);
    }

    expected(T&& value) : has_value_(true) {
        ::new (static_cast<void*>(std::addressof(value_))) T(std::move(value));
    }

    template <class G,
              class = std::enable_if_t<std::is_constructible<E, const G&>::value>>
    expected(const unexpected<G>& other) : has_value_(false) {
        ::new (static_cast<void*>(std::addressof(error_))) E(other.error());
    }

    template <class G,
              class = std::enable_if_t<std::is_constructible<E, G&&>::value>>
    expected(unexpected<G>&& other) : has_value_(false) {
        ::new (static_cast<void*>(std::addressof(error_))) E(std::move(other).error());
    }

    template <class... Args,
              class = std::enable_if_t<std::is_constructible<T, Args&&...>::value>>
    explicit expected(in_place_t, Args&&... args) : has_value_(true) {
        ::new (static_cast<void*>(std::addressof(value_))) T(std::forward<Args>(args)...);
    }

    ~expected() {
        if (has_value_) {
            value_.~T();
        } else {
            error_.~E();
        }
    }

    expected& operator=(const expected& other) {
        if (this == std::addressof(other)) {
            return *this;
        }
        if (has_value_ && other.has_value_) {
            value_ = other.value_;
        } else if (has_value_) {
            value_.~T();
            ::new (static_cast<void*>(std::addressof(error_))) E(other.error_);
            has_value_ = false;
        } else if (other.has_value_) {
            error_.~E();
            ::new (static_cast<void*>(std::addressof(value_))) T(other.value_);
            has_value_ = true;
        } else {
            error_ = other.error_;
        }
        return *this;
    }

    expected& operator=(expected&& other) {
        if (this == std::addressof(other)) {
            return *this;
        }
        if (has_value_ && other.has_value_) {
            value_ = std::move(other.value_);
        } else if (has_value_) {
            value_.~T();
            ::new (static_cast<void*>(std::addressof(error_))) E(std::move(other.error_));
            has_value_ = false;
        } else if (other.has_value_) {
            error_.~E();
            ::new (static_cast<void*>(std::addressof(value_))) T(std::move(other.value_));
            has_value_ = true;
        } else {
            error_ = std::move(other.error_);
        }
        return *this;
    }

    constexpr explicit operator bool() const noexcept { return has_value_; }
    constexpr bool has_value() const noexcept { return has_value_; }

    constexpr const T* operator->() const noexcept { return std::addressof(value_); }
    constexpr T* operator->() noexcept { return std::addressof(value_); }

    constexpr const T& operator*() const& noexcept { return value_; }
    constexpr T& operator*() & noexcept { return value_; }
    constexpr const T&& operator*() const&& noexcept { return std::move(value_); }
    constexpr T&& operator*() && noexcept { return std::move(value_); }

    // No throwing value(): the build has no exceptions, and a call on an
    // expected holding an error is a bug the debugger should catch, not an
    // exception the code cannot throw.
    constexpr const T& value() const& noexcept { return value_; }
    constexpr T& value() & noexcept { return value_; }

    constexpr const E& error() const& noexcept { return error_; }
    constexpr E& error() & noexcept { return error_; }
    constexpr const E&& error() const&& noexcept { return std::move(error_); }
    constexpr E&& error() && noexcept { return std::move(error_); }

    template <class U>
    constexpr T value_or(U&& fallback) const& {
        return has_value_ ? value_ : static_cast<T>(std::forward<U>(fallback));
    }
    template <class U>
    constexpr T value_or(U&& fallback) && {
        return has_value_ ? std::move(value_) : static_cast<T>(std::forward<U>(fallback));
    }

private:
    bool has_value_;
    union {
        T value_;
        E error_;
    };
};

template <class E>
class expected<void, E> {
public:
    using value_type = void;
    using error_type = E;
    using unexpected_type = unexpected<E>;

    expected() noexcept : has_value_(true) {}

    expected(const expected& other) : has_value_(other.has_value_) {
        if (!has_value_) {
            ::new (static_cast<void*>(std::addressof(error_))) E(other.error_);
        }
    }

    expected(expected&& other) : has_value_(other.has_value_) {
        if (!has_value_) {
            ::new (static_cast<void*>(std::addressof(error_))) E(std::move(other.error_));
        }
    }

    template <class G,
              class = std::enable_if_t<std::is_constructible<E, const G&>::value>>
    expected(const unexpected<G>& other) : has_value_(false) {
        ::new (static_cast<void*>(std::addressof(error_))) E(other.error());
    }

    template <class G,
              class = std::enable_if_t<std::is_constructible<E, G&&>::value>>
    expected(unexpected<G>&& other) : has_value_(false) {
        ::new (static_cast<void*>(std::addressof(error_))) E(std::move(other).error());
    }

    ~expected() {
        if (!has_value_) {
            error_.~E();
        }
    }

    expected& operator=(const expected& other) {
        if (this == std::addressof(other)) {
            return *this;
        }
        if (has_value_ && !other.has_value_) {
            ::new (static_cast<void*>(std::addressof(error_))) E(other.error_);
            has_value_ = false;
        } else if (!has_value_ && other.has_value_) {
            error_.~E();
            has_value_ = true;
        } else if (!has_value_) {
            error_ = other.error_;
        }
        return *this;
    }

    expected& operator=(expected&& other) {
        if (this == std::addressof(other)) {
            return *this;
        }
        if (has_value_ && !other.has_value_) {
            ::new (static_cast<void*>(std::addressof(error_))) E(std::move(other.error_));
            has_value_ = false;
        } else if (!has_value_ && other.has_value_) {
            error_.~E();
            has_value_ = true;
        } else if (!has_value_) {
            error_ = std::move(other.error_);
        }
        return *this;
    }

    constexpr explicit operator bool() const noexcept { return has_value_; }
    constexpr bool has_value() const noexcept { return has_value_; }

    constexpr void value() const noexcept {}

    constexpr const E& error() const& noexcept { return error_; }
    constexpr E& error() & noexcept { return error_; }
    constexpr const E&& error() const&& noexcept { return std::move(error_); }
    constexpr E&& error() && noexcept { return std::move(error_); }

private:
    bool has_value_;
    union {
        E error_;
    };
};

}  // namespace std
