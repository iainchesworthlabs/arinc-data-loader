// std::endian / std::byteswap / std::rotl / std::rotr shim for GHS builds
// whose standard library predates <bit> (C++20). Shadowed in only when the
// toolchain lacks the header (cmake/GhsStdShims.cmake).
//
// native is hard-wired to big: the GHS INTEGRITY targets this project builds
// are big-endian PowerPC. If a little-endian GHS target joins, this is the one
// line to change - there is deliberately no preprocessor endian probe, because
// this repository's first-party code carries no #if.

#pragma once

#include <cstdint>
#include <type_traits>

namespace std {

enum class endian {
    little = 1,
    big = 2,
    native = big,  // PowerPC, the GHS target this shim exists for
};

template <class T>
constexpr T byteswap(T value) noexcept {
    static_assert(std::is_integral<T>::value, "byteswap requires an integral type");
    using U = typename std::make_unsigned<T>::type;
    constexpr std::size_t bytes = sizeof(T);
    const U u = static_cast<U>(value);
    if constexpr (bytes == 1) {
        return value;
    } else if constexpr (bytes == 2) {
        return static_cast<T>(static_cast<U>((u & 0x00FFu) << 8) |
                              static_cast<U>((u & 0xFF00u) >> 8));
    } else if constexpr (bytes == 4) {
        return static_cast<T>(
            static_cast<U>((u & 0x000000FFull) << 24) |
            static_cast<U>((u & 0x0000FF00ull) << 8) |
            static_cast<U>((u & 0x00FF0000ull) >> 8) |
            static_cast<U>((u & 0xFF000000ull) >> 24));
    } else if constexpr (bytes == 8) {
        return static_cast<T>(
            static_cast<U>((u & 0x00000000000000FFull) << 56) |
            static_cast<U>((u & 0x000000000000FF00ull) << 40) |
            static_cast<U>((u & 0x0000000000FF0000ull) << 24) |
            static_cast<U>((u & 0x00000000FF000000ull) << 8) |
            static_cast<U>((u & 0x000000FF00000000ull) >> 8) |
            static_cast<U>((u & 0x0000FF0000000000ull) >> 24) |
            static_cast<U>((u & 0x00FF000000000000ull) >> 40) |
            static_cast<U>((u & 0xFF00000000000000ull) >> 56));
    } else {
        static_assert(bytes == 1, "byteswap supports 1, 2, 4 and 8 byte integrals only");
    }
}

template <class T>
constexpr T rotl(T value, int shift) noexcept {
    static_assert(std::is_integral<T>::value && std::is_unsigned<T>::value,
                  "rotl requires an unsigned integral type");
    constexpr std::size_t digits = sizeof(T) * 8;
    // The standard restricts shift to [0, digits); this masks instead, which
    // is the natural behaviour and keeps the one call site's table-driven
    // rotations correct without a branch.
    const int amount = shift & static_cast<int>(digits - 1);
    if (amount == 0) {
        return value;
    }
    return static_cast<T>(static_cast<T>(value << amount) |
                          static_cast<T>(value >> (digits - amount)));
}

template <class T>
constexpr T rotr(T value, int shift) noexcept {
    static_assert(std::is_integral<T>::value && std::is_unsigned<T>::value,
                  "rotr requires an unsigned integral type");
    constexpr std::size_t digits = sizeof(T) * 8;
    const int amount = shift & static_cast<int>(digits - 1);
    if (amount == 0) {
        return value;
    }
    return static_cast<T>(static_cast<T>(value >> amount) |
                          static_cast<T>(value << (digits - amount)));
}

}  // namespace std
