               "tools/network-access/**", "tools/repo/**"],
  "build": ["libs/**", "apps/**", "tests/**", "CMakeLists.txt", "CMakePresets.json", "vcpkg.json", "cmake/**", "packaging/**",
            "notices/**", "zephyr/**", "tools/checks/**", "tools/release/**", "tools/coverage-floors.json",
