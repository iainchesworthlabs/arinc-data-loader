inline constexpr weak_ordering weak_ordering::greater{1};

class partial_ordering {
public:
    static const partial_ordering less;
    static const partial_ordering equivalent;
    static const partial_ordering greater;
    static const partial_ordering unordered;

    // Unordered compares equal to itself and orders below the rest, as the
    // standard's tables have it.
    constexpr bool operator==(partial_ordering other) const noexcept {
        return value_ == other.value_;
    }
    constexpr bool operator!=(partial_ordering other) const noexcept {
        return value_ != other.value_;
    }
    constexpr bool operator<(partial_ordering other) const noexcept {
        return value_ != unordered_value_ && value_ < other.value_;
    }
    constexpr bool operator<=(partial_ordering other) const noexcept {
        return value_ != unordered_value_ && value_ <= other.value_;
    }
    constexpr bool operator>(partial_ordering other) const noexcept {
        return value_ != unordered_value_ && value_ > other.value_;
    }
    constexpr bool operator>=(partial_ordering other) const noexcept {
        return value_ != unordered_value_ && value_ >= other.value_;
    }

    friend constexpr bool operator==(partial_ordering v, int zero) noexcept {
        return zero == 0 && v.value_ == 0;
    }
    friend constexpr bool operator!=(partial_ordering v, int zero) noexcept {
        return zero == 0 && v.value_ != 0;
    }
    friend constexpr bool operator<(partial_ordering v, int zero) noexcept {
        return zero == 0 && v.value_ != unordered_value_ && v.value_ < 0;
    }
    friend constexpr bool operator<=(partial_ordering v, int zero) noexcept {
        return zero == 0 && v.value_ != unordered_value_ && v.value_ <= 0;
    }
    friend constexpr bool operator>(partial_ordering v, int zero) noexcept {
        return zero == 0 && v.value_ != unordered_value_ && v.value_ > 0;
    }
    friend constexpr bool operator>=(partial_ordering v, int zero) noexcept {
        return zero == 0 && v.value_ != unordered_value_ && v.value_ >= 0;
    }

private:
    constexpr explicit partial_ordering(int value) noexcept : value_(value) {}
    static constexpr int unordered_value_ = 0x7fffffff;
    int value_;
};

inline constexpr partial_ordering partial_ordering::less{-1};
inline constexpr partial_ordering partial_ordering::equivalent{0};
inline constexpr partial_ordering partial_ordering::greater{1};
inline constexpr partial_ordering partial_ordering::unordered{unordered_value_};

}  // namespace std
