/* The flash behind the test file system. native_sim's own is 2 MB with a 16 KB storage
 * partition; the conformance suite writes files of 300 KB, so the flash is made 8 MB and
 * the storage partition 4 MB of it. */

/delete-node/ &storage_partition;

&flashcontroller0 {
	reg = <0x00000000 DT_SIZE_M(8)>;
};

&flash0 {
	reg = <0x00000000 DT_SIZE_M(8)>;

	partitions {
		storage_partition: partition@200000 {
			label = "storage";
			reg = <0x00200000 DT_SIZE_M(4)>;
		};
	};
};
