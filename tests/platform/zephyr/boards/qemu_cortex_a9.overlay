/* A flash behind the test file system: Zephyr's flash simulator, a RAM array, 8 MB with a 4 MB
 * storage partition, as native_sim has (this board has no flash of its own). */

/ {
	flashcontroller0: flash-controller@0 {
		compatible = "zephyr,sim-flash";
		reg = <0x00000000 DT_SIZE_M(8)>;

		#address-cells = <1>;
		#size-cells = <1>;
		erase-value = <0xff>;

		sim_flash0: flash@0 {
			status = "okay";
			compatible = "soc-nv-flash";
			erase-block-size = <4096>;
			write-block-size = <1>;
			reg = <0x00000000 DT_SIZE_M(8)>;

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				storage_partition: partition@200000 {
					label = "storage";
					reg = <0x00200000 DT_SIZE_M(4)>;
				};
			};
		};
	};
};
