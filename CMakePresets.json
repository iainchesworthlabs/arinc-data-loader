{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/deps/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows (MSVC, Debug)",
      "inherits": [
        "windows-msvc-base",
        "debug"
      ]
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows (MSVC, Release)",
      "inherits": [
        "windows-msvc-base",
        "release"
      ]
    },
    {
      "name": "linux-gcc-base",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux (GCC, Debug)",
      "inherits": [
        "linux-gcc-base",
        "debug"
      ]
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux (GCC, Release)",
      "inherits": [
        "linux-gcc-base",
        "release"
      ]
    },
    {
      "name": "linux-gcc-coverage",
      "displayName": "Linux (GCC, Coverage)",
      "inherits": [
        "linux-gcc-base",
        "debug"
      ],
      "cacheVariables": {
        "ADL_ENABLE_COVERAGE": "ON",
        "ADL_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "macos-clang-base",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "macos-clang-debug",
      "displayName": "macOS (Clang, Debug)",
      "inherits": [
        "macos-clang-base",
        "debug"
      ]
    },
    {
      "name": "macos-clang-release",
      "displayName": "macOS (Clang, Release)",
      "inherits": [
        "macos-clang-base",
        "release"
      ]
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release" },
    { "name": "linux-gcc-coverage", "configurePreset": "linux-gcc-coverage" },
    { "name": "macos-clang-debug", "configurePreset": "macos-clang-debug" },
    { "name": "macos-clang-release", "configurePreset": "macos-clang-release" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug", "inherits": ["base"] },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release", "inherits": ["base"] },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug", "inherits": ["base"] },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release", "inherits": ["base"] },
    { "name": "linux-gcc-coverage", "configurePreset": "linux-gcc-coverage", "inherits": ["base"] },
    { "name": "macos-clang-debug", "configurePreset": "macos-clang-debug", "inherits": ["base"] },
    { "name": "macos-clang-release", "configurePreset": "macos-clang-release", "inherits": ["base"] }
  ]
}
