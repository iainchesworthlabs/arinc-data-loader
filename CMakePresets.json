{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded",
        "CMAKE_POLICY_DEFAULT_CMP0141": "NEW"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows (MSVC, Debug)",
      "inherits": [
        "windows-msvc-base",
        "debug"
      ]
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows (MSVC, Release)",
      "inherits": [
        "windows-msvc-base",
        "release"
      ]
    },
    {
      "name": "windows-msvc-analyze",
      "displayName": "Windows (MSVC, Code Analysis)",
      "description": "Debug build with MSVC /analyze; static-analysis.yml builds it nightly",
      "inherits": [
        "windows-msvc-base",
        "debug"
      ],
      "cacheVariables": {
        "ADL_ENABLE_MSVC_ANALYSIS": "ON",
        "ADL_ENABLE_SANITIZERS": "OFF",
        "ADL_BUILD_APP": "ON",
        "ADL_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-gcc-base",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux (GCC, Debug)",
      "inherits": [
        "linux-gcc-base",
        "debug"
      ]
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux (GCC, Release)",
      "inherits": [
        "linux-gcc-base",
        "release"
      ]
    },
    {
      "name": "linux-gcc-coverage",
      "displayName": "Linux (GCC, Coverage)",
      "inherits": [
        "linux-gcc-base",
        "debug"
      ],
      "cacheVariables": {
        "ADL_ENABLE_COVERAGE": "ON",
        "ADL_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "linux-gcc-tidy",
      "displayName": "Linux (GCC, clang-tidy)",
      "description": "clang-tidy runs as the compiler launcher; static-analysis.yml builds it nightly",
      "inherits": [
        "linux-gcc-base",
        "debug"
      ],
      "cacheVariables": {
        "ADL_ENABLE_CLANG_TIDY": "ON",
        "ADL_ENABLE_SANITIZERS": "OFF",
        "ADL_BUILD_APP": "OFF",
        "ADL_BUILD_TESTS": "OFF",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "linux-gcc-sonar",
      "displayName": "Linux (GCC, Sonar compile commands)",
      "description": "Configure only: writes the compile_commands.json the SonarQube job scans",
      "inherits": [
        "linux-gcc-base",
        "debug"
      ],
      "cacheVariables": {
        "ADL_ENABLE_SANITIZERS": "OFF",
        "ADL_BUILD_APP": "OFF",
        "ADL_BUILD_TESTS": "OFF",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "linux-clang-base",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux (Clang, Debug)",
      "description": "Clang's ASan and UBSan over the libraries and tests; static-analysis.yml builds it nightly",
      "inherits": [
        "linux-clang-base",
        "debug"
      ],
      "cacheVariables": {
        "ADL_BUILD_APP": "OFF"
      }
    },
    {
      "name": "macos-clang-base",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.4"
      }
    },
    {
      "name": "macos-clang-debug",
      "displayName": "macOS (Clang, Debug)",
      "inherits": [
        "macos-clang-base",
        "debug"
      ]
    },
    {
      "name": "macos-clang-release",
      "displayName": "macOS (Clang, Release)",
      "inherits": [
        "macos-clang-base",
        "release"
      ]
    },
    {
      "name": "ghs-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ADL_BUILD_TESTS": "OFF",
        "ADL_BUILD_APP": "OFF",
        "ADL_ENABLE_SANITIZERS": "OFF",
        "ADL_ACCEPT_UNBUILT_PLATFORM": "ON"
      }
    },
    {
      "name": "ghs508-ghs-base",
      "hidden": true,
      "inherits": [
        "ghs-base"
      ],
      "toolchainFile": "${sourceDir}/cmake/toolchains/ghs-integrity508.cmake",
      "cacheVariables": {
        "ADL_TARGET_PLATFORM": "ghs508"
      }
    },
    {
      "name": "ghs508-ghs-debug",
      "displayName": "INTEGRITY 5.0.8 (GHS, Debug)",
      "inherits": [
        "ghs508-ghs-base",
        "debug"
      ]
    },
    {
      "name": "ghs508-ghs-release",
      "displayName": "INTEGRITY 5.0.8 (GHS, Release)",
      "inherits": [
        "ghs508-ghs-base",
        "release"
      ]
    },
    {
      "name": "ghs178b-ghs-base",
      "hidden": true,
      "inherits": [
        "ghs-base"
      ],
      "toolchainFile": "${sourceDir}/cmake/toolchains/ghs-integrity178b.cmake",
      "cacheVariables": {
        "ADL_TARGET_PLATFORM": "ghs178b"
      }
    },
    {
      "name": "ghs178b-ghs-debug",
      "displayName": "INTEGRITY-178B (GHS, Debug)",
      "inherits": [
        "ghs178b-ghs-base",
        "debug"
      ]
    },
    {
      "name": "ghs178b-ghs-release",
      "displayName": "INTEGRITY-178B (GHS, Release)",
      "inherits": [
        "ghs178b-ghs-base",
        "release"
      ]
    },
    {
      "name": "linux-base",
      "hidden": true,
      "description": "Linux with whichever compiler CC and CXX name (CI sets them); the standard presets build on it",
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux (Debug, no sanitizers)",
      "inherits": [
        "linux-base",
        "debug"
      ],
      "cacheVariables": {
        "ADL_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "linux-codeql",
      "displayName": "Linux (CodeQL: the libraries and the platform layer)",
      "description": "The lean build CodeQL traces: no tests, no applications, no sanitizers (its tracer's LD_PRELOAD collides with ASan), no module scanning",
      "inherits": [
        "linux-debug"
      ],
      "cacheVariables": {
        "ADL_BUILD_TESTS": "OFF",
        "ADL_BUILD_APP": "OFF",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux (Release)",
      "inherits": [
        "linux-base",
        "release"
      ]
    },
    {
      "name": "linux-asan-ubsan",
      "displayName": "Linux (AddressSanitizer and UBSan, -O1)",
      "inherits": [
        "linux-base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ADL_ENABLE_SANITIZERS": "OFF",
        "ICL_SANITIZERS": "address,undefined"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux (ThreadSanitizer, -O1)",
      "inherits": [
        "linux-base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ADL_ENABLE_SANITIZERS": "OFF",
        "ICL_SANITIZERS": "thread"
      }
    },
    {
      "name": "linux-coverage",
      "displayName": "Linux (Coverage)",
      "inherits": [
        "linux-base",
        "debug"
      ],
      "cacheVariables": {
        "ADL_ENABLE_COVERAGE": "ON",
        "ADL_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "linux-fuzz",
      "displayName": "Linux (libFuzzer with ASan and UBSan; use Clang)",
      "description": "Builds the libraries and the libFuzzer harnesses only; ctest --preset linux-fuzz replays the seed corpus and the past crashes",
      "inherits": [
        "linux-base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ADL_ENABLE_SANITIZERS": "OFF",
        "ADL_ENABLE_FUZZING": "ON",
        "ADL_BUILD_TESTS": "OFF",
        "ADL_BUILD_APP": "OFF"
      }
    },
    {
      "name": "linux-perf",
      "displayName": "Linux (Release, micro-benchmarks)",
      "description": "Builds the libraries and the Catch2 benchmarks only; ctest --preset linux-perf runs them and writes build/linux-perf/perf/*.xml for tools/ci/perf_compare.py",
      "inherits": [
        "linux-base",
        "release"
      ],
      "cacheVariables": {
        "ADL_BUILD_BENCHMARKS": "ON",
        "ADL_BUILD_TESTS": "OFF",
        "ADL_BUILD_APP": "OFF"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS (Release)",
      "inherits": [
        "macos-clang-base",
        "release"
      ]
    },
    {
      "name": "windows-msvc-asan",
      "displayName": "Windows (MSVC, AddressSanitizer)",
      "inherits": [
        "windows-msvc-base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ADL_ENABLE_SANITIZERS": "ON",
        "ICL_SANITIZERS": "address"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
    { "name": "windows-msvc-analyze", "configurePreset": "windows-msvc-analyze" },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release" },
    { "name": "linux-gcc-coverage", "configurePreset": "linux-gcc-coverage" },
    { "name": "linux-gcc-tidy", "configurePreset": "linux-gcc-tidy" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
    { "name": "macos-clang-debug", "configurePreset": "macos-clang-debug" },
    { "name": "macos-clang-release", "configurePreset": "macos-clang-release" },
    { "name": "ghs508-ghs-debug", "configurePreset": "ghs508-ghs-debug" },
    { "name": "ghs508-ghs-release", "configurePreset": "ghs508-ghs-release" },
    { "name": "ghs178b-ghs-debug", "configurePreset": "ghs178b-ghs-debug" },
    { "name": "ghs178b-ghs-release", "configurePreset": "ghs178b-ghs-release" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-codeql", "configurePreset": "linux-codeql" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-asan-ubsan", "configurePreset": "linux-asan-ubsan" },
    { "name": "linux-tsan", "configurePreset": "linux-tsan" },
    { "name": "linux-coverage", "configurePreset": "linux-coverage" },
    { "name": "macos-release", "configurePreset": "macos-release" },
    { "name": "windows-msvc-asan", "configurePreset": "windows-msvc-asan" },
    { "name": "linux-fuzz", "configurePreset": "linux-fuzz" },
    { "name": "linux-perf", "configurePreset": "linux-perf" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "TEMP": "${sourceDir}/build/${presetName}",
        "TMP": "${sourceDir}/build/${presetName}",
        "TMPDIR": "${sourceDir}/build/${presetName}",
        "LSAN_OPTIONS": "suppressions=${sourceDir}/tests/lsan.supp:print_suppressions=0"
      }
    },
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug", "inherits": ["base"] },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release", "inherits": ["base"] },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug", "inherits": ["base"] },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release", "inherits": ["base"] },
    { "name": "linux-gcc-coverage", "configurePreset": "linux-gcc-coverage", "inherits": ["base"] },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug", "inherits": ["base"] },
    { "name": "macos-clang-debug", "configurePreset": "macos-clang-debug", "inherits": ["base"] },
    { "name": "macos-clang-release", "configurePreset": "macos-clang-release", "inherits": ["base"] },
    { "name": "linux-debug", "configurePreset": "linux-debug", "inherits": ["base"] },
    { "name": "linux-release", "configurePreset": "linux-release", "inherits": ["base"] },
    { "name": "linux-asan-ubsan", "configurePreset": "linux-asan-ubsan", "inherits": ["base"] },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "inherits": ["base"],
      "description": "Not the tests that run Qt's event loop or threads: Qt and glib are not built with ThreadSanitizer, so it reports their hand-off between threads (queued signals, eventfd) as races. The platform, engine and library tests run.",
      "filter": {
        "exclude": {
          "name": "^(app|mock|media_gen|ui|loopback)\\.|^system\\.adl_"
        }
      }
    },
    { "name": "linux-coverage", "configurePreset": "linux-coverage", "inherits": ["base"] },
    { "name": "macos-release", "configurePreset": "macos-release", "inherits": ["base"] },
    { "name": "windows-msvc-asan", "configurePreset": "windows-msvc-asan", "inherits": ["base"] },
    { "name": "linux-fuzz", "configurePreset": "linux-fuzz", "inherits": ["base"], "filter": { "include": { "label": "fuzz" } } },
    { "name": "linux-perf", "configurePreset": "linux-perf", "inherits": ["base"], "filter": { "include": { "label": "perf" } } }
  ]
}
